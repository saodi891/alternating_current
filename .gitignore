# Python 虚拟环境
.venv/
venv/

# 打包产物（build_exe.py 每次会重新生成）
build/
dist/
*.spec

# Python 缓存
__pycache__/
*.pyc

# 运行时生成、含你的真实 QQ/群/Token —— 绝不上传
config.json

# 不开源图标（本地保留照常打包，仓库里不放；构建时缺图标会自动用默认图标）
icon.ico
icon.PNG
*.ico
*.png

# 你自己的私人语音，别人不需要（保留说明文件）
voices/*
!voices/把语音文件放这里.txt

# 编辑器
.idea/
.vscode/
